<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\useful\libs\Useful.Graphics\Useful.Graphics.csproj" />
    <ProjectReference Include="..\..\..\useful\test\Useful.Fakes\Useful.Fakes.csproj" />
    <!-- Referenced directly, unlike the game, because these tests are about
         what the two shipped missions do rather than about finding them. -->
    <ProjectReference Include="..\..\libs\EliteSharp.Missions.Classic\EliteSharp.Missions.Classic.csproj" />
    <ProjectReference Include="..\..\libs\EliteSharpLib\EliteSharpLib.csproj" />
    <ProjectReference Include="..\EliteSharpLib.Fakes\EliteSharpLib.Fakes.csproj" />
    <!-- Built and copied, but deliberately not referenced: the loader has to
         find this the way it finds a stranger's plugin, off disk. -->
    <ProjectReference Include="..\EliteSharp.Missions.TestPlugin\EliteSharp.Missions.TestPlugin.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Graphics\2x2redtopleft.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The shipped missions, into a Missions folder, exactly as the app's build
       does it. The tests that drive the game's real composition have to find
       their missions the way the game does, or they would be proving something
       the shipped configuration does not do. -->
  <Target Name="CopyMissionPlugins" AfterTargets="Build">
    <MSBuild Projects="..\..\libs\EliteSharp.Missions.Classic\EliteSharp.Missions.Classic.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="MissionPlugin" />
    </MSBuild>
    <Copy SourceFiles="@(MissionPlugin)"
          DestinationFolder="$(OutDir)Missions"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
