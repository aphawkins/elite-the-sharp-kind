<Project Sdk="Microsoft.NET.Sdk">

  <!-- The seventeen goods Elite has always traded in, as a plugin. It
       references the contracts and nothing else - not the game - which is the
       whole point: whatever the game can do for these it can do for anyone's.
       It is not referenced by the game either; the app's build drops the DLL
       into the Goods folder beside the executable and the loader finds it
       there. -->

  <ItemGroup>
    <ProjectReference Include="..\EliteSharp.Abstractions\EliteSharp.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The table itself, which travels with the assembly and is read from
         beside it. Content rather than None, so a project that references this
         one gets the file in its own output too - the tests do. -->
    <Content Include="goods.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
