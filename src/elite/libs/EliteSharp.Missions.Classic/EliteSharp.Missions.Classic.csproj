<Project Sdk="Microsoft.NET.Sdk">

  <!-- The two missions Elite has always had, as a plugin. It references the
       contracts and nothing else - not the game - which is the whole point:
       whatever the game can do for these it can do for anyone's. It is not
       referenced by the game either; the app's build drops the DLL into the
       Missions folder beside the executable and the loader finds it there. -->

  <ItemGroup>
    <ProjectReference Include="..\EliteSharp.Missions.Abstractions\EliteSharp.Missions.Abstractions.csproj" />
  </ItemGroup>

</Project>
