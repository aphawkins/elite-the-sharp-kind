<Project Sdk="Microsoft.NET.Sdk">

  <!-- A window that draws every control, for looking at them. The control tests
       assert on the calls a control makes; this is for the half that only an
       eye can check - whether a thing is centred, whether the arrows sit
       where they should, whether a state reads as selected. Run it with
       "dotnet run" against this project. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\Useful.App\Useful.App.csproj" />
    <ProjectReference Include="..\..\libs\Useful.UI\Useful.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The font and palette are the 8-bit rendition's, linked rather than
         copied: a gallery with its own drifting copy of the font would stop
         showing what the game shows. -->
    <None Include="..\..\..\elite\libs\EliteSharp.Renditions.EightBit\Assets\FontsBitmap\bbc-micro.bmp"
          Link="Assets\FontsBitmap\bbc-micro.bmp"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\elite\libs\EliteSharp.Renditions.EightBit\Assets\Palette\palette.json"
          Link="Assets\Palette\palette.json"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The Hardware backend draws text through TTF rather than the bitmap
         sheet, and measures it differently, so the gallery carries a true-type
         font too: switching engine.backend in gallery.sharp is how the controls
         get checked against the other renderer. -->
    <None Include="..\..\..\elite\libs\EliteSharpLib\Assets\FontsTrueType\OpenSans-Regular.ttf"
          Link="Assets\FontsTrueType\OpenSans-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
