# editorconfig.org

# inherits higher configs

[*.cs]

# CA5394: Do not use insecure randomness
# Disabled for this project only: RandomSource is the single place the
# games reach System.Random, and it is deliberately the fast, seedable
# kind - game and test randomness, never a security boundary. Everything
# else goes through IRandomSource, so the rule stays enforced elsewhere.
dotnet_diagnostic.CA5394.severity = none
