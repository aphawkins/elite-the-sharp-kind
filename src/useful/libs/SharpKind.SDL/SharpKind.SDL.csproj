<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SharpKind.SDL</PackageId>
    <Description>SDL3-backed windowing, input, audio and hardware-accelerated rendering abstraction for SharpKind-based games.</Description>
    <!-- Required by ppy.SDL3-CS / ppy.SDL3_ttf-CS / ppy.SDL3_mixer-CS, which expose raw unmanaged pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="ppy.SDL3-CS" />
		<PackageReference Include="ppy.SDL3_mixer-CS" />
		<PackageReference Include="ppy.SDL3_ttf-CS" />
	</ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpKind.Abstraction\SharpKind.Abstraction.csproj" />
    <ProjectReference Include="..\SharpKind.Assets\SharpKind.Assets.csproj" />
    <ProjectReference Include="..\SharpKind.Audio\SharpKind.Audio.csproj" />
    <ProjectReference Include="..\SharpKind.Input\SharpKind.Input.csproj" />
    <ProjectReference Include="..\SharpKind.Graphics\SharpKind.Graphics.csproj" />
    <ProjectReference Include="..\SharpKind\SharpKind.csproj" />
  </ItemGroup>
</Project>
